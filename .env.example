# Copy to `.env` and fill in. Never commit `.env`.
# PostgreSQL / Neon connection string for development (persistence).
# When unset, the API falls back to an in-memory store.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: override server port (default 3000).
# PORT=3000

# Optional: a separate DB used only by `npm test` (persistence tests).
# When unset, DB-backed tests are skipped and in-memory tests run.
# TEST_DATABASE_URL=postgres://user:password@host:5432/testdb